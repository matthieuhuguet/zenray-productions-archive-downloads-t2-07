<!doctype html>
<!-- HDA logo : mot-symbole plus pastille plus sous-titre. Tout est parametre. -->
<html><head><meta charset="utf-8">
<style>
  @font-face { font-family:'Display'; src:url('file:///Users/zenray/Library/Fonts/AnthropicSans-Black.ttf'); }
  @font-face { font-family:'Body';    src:url('file:///Users/zenray/Library/Fonts/AnthropicSans-Medium.ttf');    }
  html, body { margin:0; padding:0; background:transparent; }
